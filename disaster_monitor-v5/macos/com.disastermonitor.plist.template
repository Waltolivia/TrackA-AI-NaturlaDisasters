<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.disastermonitor</string>
<key>ProgramArguments</key><array><string>__PROJECT_DIR__/.venv/bin/python</string><string>-m</string><string>disaster_monitor.main</string></array>
<key>WorkingDirectory</key><string>__PROJECT_DIR__</string>
<key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
<key>StandardOutPath</key><string>__PROJECT_DIR__/logs/launchd.out.log</string>
