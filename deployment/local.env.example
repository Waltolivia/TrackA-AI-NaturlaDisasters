# Copy this file to deployment/local.env, replace the placeholders, confirm
# the shared region, and run `source deployment/local.env` from every terminal
# used by the collector or worker. This file contains settings, not AI keys.

export NWS_USER_AGENT='BYU-TrackA-DisasterResearch/1.0 (YOUR_EMAIL)'

# Primary shared file archive. Every teammate must use the same three values.
export AWS_PROFILE='tracka'
export AWS_REGION='us-west-2'
export S3_ARCHIVE_ENABLED=true
export S3_BUCKET='byu-tracka-disaster-study'
export S3_PREFIX='disaster_monitor-v5/archive'
export S3_SYNC_SECONDS=5
export S3_RETRY_SECONDS=60
export S3_BACKFILL_ON_START=true

# Optional and normally false. When true, old finished ground-truth rows are
# copied to DynamoDB and then removed from local SQLite/report storage.
export DYNAMODB_ARCHIVE_ENABLED=false
export AWS_DYNAMODB_TABLE='disaster_monitor_history'
export LOCAL_RETENTION_DAYS=7
