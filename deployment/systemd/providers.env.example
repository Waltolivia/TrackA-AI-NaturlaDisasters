OPENAI_API_KEY=replace-me
ANTHROPIC_API_KEY=replace-me
GEMINI_API_KEY=replace-me

# Use the same S3 settings as collector.env. Prefer an EC2 instance role in
# production; otherwise configure credentials outside Git with `aws configure`.
S3_ARCHIVE_ENABLED=true
S3_BUCKET=replace-with-globally-unique-bucket-name
S3_PREFIX=disaster_monitor-v5/archive
S3_RETRY_SECONDS=60
AWS_REGION=us-west-2
