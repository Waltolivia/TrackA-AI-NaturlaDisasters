NWS_USER_AGENT="BYU-TrackA-DisasterResearch/1.0 (contact@example.edu)"
NWS_POLL_SECONDS=60
EONET_POLL_SECONDS=600
EONET_DAYS=30
SUPPRESS_INITIAL_SYNC=true

# Primary shared file archive. Use the same values in providers.env so the
# collector and AI worker write beneath the same event prefix.
S3_ARCHIVE_ENABLED=true
S3_BUCKET=replace-with-globally-unique-bucket-name
S3_PREFIX=disaster_monitor-v5/archive
S3_SYNC_SECONDS=5
AWS_REGION=us-west-2

# Tiered storage: keep LOCAL_RETENTION_DAYS locally, then move older finished
# events to Amazon DynamoDB. Leave AWS_ARCHIVE_ENABLED unset/false to keep all
# data on disk. Credentials come from the normal boto3 chain (instance role or
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY).
# LOCAL_RETENTION_DAYS=7
# AWS_ARCHIVE_ENABLED=true
# AWS_REGION is shared with S3 above.
# AWS_DYNAMODB_TABLE=disaster_monitor_history
# AWS_ARCHIVE_INTERVAL_HOURS=24
