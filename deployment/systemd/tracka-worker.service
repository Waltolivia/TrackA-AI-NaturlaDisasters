[Unit]
Description=Track A AI probe pipeline worker
Wants=network-online.target
After=network-online.target tracka-collector.service

[Service]
Type=simple
User=tracka
Group=tracka
WorkingDirectory=/opt/tracka
EnvironmentFile=/etc/tracka/providers.env
ExecStart=/opt/tracka/pipeline_worker/.venv/bin/pipeline-worker --targets /opt/tracka/ai_probe_runner/config/targets.study-v3-search.json --question-bank-dir /opt/tracka/ai_probe_runner/config/question_banks_v3 --max-attempts 8 --retry-base-seconds 60 --poll-seconds 5 run
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
